events {}

http {
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # Default server: reject requests with an unrecognised Host header.
    server {
        listen      9091 default_server;
        server_name _;
        return      421;
    }

    # Forward requests whose Host header matches the configured pattern
    # to the local Kubernetes ingress.
    server {
        listen      9091;
        server_name ~^${CLOUD_CONNECT_ALLOWED_HOST_PATTERN}$;

        location / {
            proxy_pass         http://${CLOUD_CONNECT_LOCAL_INGRESS};
            proxy_http_version 1.1;
            proxy_set_header   Host            $host;
            proxy_set_header   Upgrade         $http_upgrade;
            proxy_set_header   Connection      $connection_upgrade;
            proxy_set_header   X-Real-IP       $remote_addr;
            proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        }
    }
}
