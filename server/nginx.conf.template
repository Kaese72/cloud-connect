events {}

http {
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    server {
        listen 8080;

        # Reverse tunnel establishment: WebSocket from the local pod's chisel client.
        # Path-stripped before forwarding so chisel server sees requests at its root.
        location /cloud-connect/v0/tunnel {
            proxy_pass         http://127.0.0.1:8081;
            proxy_http_version 1.1;
            proxy_set_header   Upgrade    $http_upgrade;
            proxy_set_header   Connection "Upgrade";
            proxy_set_header   Host       $host;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
        }

        # All other traffic is forwarded through the reverse tunnel.
        # Host is rewritten to the configured internal DNS name so the local
        # ingress can route the request correctly.
        location / {
            proxy_pass         http://127.0.0.1:9090;
            proxy_http_version 1.1;
            proxy_set_header   Host              "${CLOUD_CONNECT_INTERNAL_HOST}";
            proxy_set_header   Upgrade           $http_upgrade;
            proxy_set_header   Connection        $connection_upgrade;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
        }
    }
}
